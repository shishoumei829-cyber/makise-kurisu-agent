# 复制为 .env 或在本机「用户环境变量」中配置（Ollama 相关变量需作用于运行 ollama serve 的进程）
# 详见 docs/GPU_OLLAMA_SOVITS.md

# --- Amadeus 后端（Node server.js）---
# 服务端口（Electron 与后端需一致）
# AMADEUS_BACKEND_PORT=3000

# 8GB 显存友好：默认已在代码里设为 2048 / 6000，此处仅覆盖
# 1=主对话轻量路径（默认）；0=恢复周期元认知洞察等
# 高亲密度模式（默认开；设为 0 关闭）
AMADEUS_HIGH_INTIMACY=1
# 对话对象：okabe（默认冈部伦太郎）；custom=仅依赖 whoami 档案，不自动认定冈部
AMADEUS_PARTNER_ID=okabe
# 启动时把 whoami 写成冈部档案（0 关闭）
# AMADEUS_PARTNER_BOOTSTRAP=1

AMADEUS_CHAT_MINIMAL=1
# Brain v1 中央认知循环：0=legacy 路由（默认）；1=Brain.turn()+瘦prompt+Monitor
# AMADEUS_BRAIN=0
# AMADEUS_BRAIN_MONITOR=1
# AMADEUS_BRAIN_DELIB_LLM=auto
# AMADEUS_BRAIN_PROMPT_SLIM=1
# 意识层（全局工作空间）：默认开；设 0 关闭
# AMADEUS_BRAIN_CONSCIOUSNESS=1
# 主动开口须过意识阈值才说话（实验）：1=严格
# AMADEUS_BRAIN_CONSCIOUS_PROACTIVE=0
AMADEUS_OLLAMA_NUM_CTX=4096
AMADEUS_MAX_PROMPT_CHARS=4200
# 日语校验：0 关闭；默认开启（中文→日译→规则/LLM 自检）
# AMADEUS_JP_VALIDATE=0
# 日语定稿优先：1 时回复后走 JP-first（先日语定稿再译中文，较慢但更稳）
# AMADEUS_JP_FIRST=0
# AMADEUS_JP_LLM_CHECK=0
# 固定台词/OOC 兜底默认关闭；只有确实需要时才设为 1
# AMADEUS_REPLY_FALLBACK=0
# 默认开启低延迟流式语音；日语模式(AMADEUS_REPLY_LANGUAGE=ja)下仍会强制定稿硬翻，不会跳过
# AMADEUS_FAST_STREAMING_VOICE=1
# AMADEUS_LITE_MODEL=kurisu:latest
# 主对话模型（须与 ollama list 一致）
# AMADEUS_CHAT_MODEL=kurisu:latest
# 微调候选（可选）：AMADEUS_CHAT_MODEL=kurisu-v4-candidate
# 0=关闭 OOC 整句替换兜底（「你到底想说什么」等固定句）；1=开启（默认）
# AMADEUS_OOC_REPAIR=1
# AMADEUS_REPLY_LANGUAGE=ja
# 日→中显示翻译模型。ja 模式下走硬翻（直译、不通顺化、不脑补），不是“自然对白”润色
# AMADEUS_TRANSLATE_MODEL=qwen2.5:3b
# 默认复用主模型，避免 8GB 显存来回换模；仅在显存充足时另设模型
# AMADEUS_CONTINUITY_MODEL=kurisu:latest
# AMADEUS_JP_FIRST=0
# 多轮对话发往 Ollama 时最多保留几条消息（user+assistant 合计，不含 system）；过大易挤爆 num_ctx
# AMADEUS_CHAT_HISTORY_MSGS=24
AMADEUS_OLLAMA_BASE=http://127.0.0.1:11434
# Ollama 模型常驻时间，8GB 建议 2m，避免长期占满与 SoVITS 抢显存
AMADEUS_OLLAMA_KEEP_ALIVE=2m
# 启动后后台预热主模型；0 关闭
# AMADEUS_PREWARM=1

# --- 智能管家执行脑与本地权限 ---
# 复杂任务规划器。配置后只输出结构化工具计划，不参与人格台词。
# AMADEUS_WORK_BRAIN=deepseek
# AMADEUS_OPENAI_API_KEY=
# AMADEUS_WORK_OPENAI_BASE=https://api.deepseek.com/v1
# AMADEUS_WORK_OPENAI_MODEL=deepseek-chat
# AMADEUS_WORK_REASONER_MODEL=deepseek-chat
# 允许只读文件搜索的根目录，多个目录用英文分号分隔；未设置时为 Downloads、用户目录和项目目录。
# AMADEUS_BUTLER_ALLOWED_ROOTS=C:\Users\yourname\Downloads;D:\Projects
# 后台执行安全且已规划的低风险任务；设为 0 可完全暂停执行。
# AMADEUS_BUTLER_OPERATOR=1

# --- Ollama 服务进程（须在启动 ollama 前设置，或写入系统用户环境变量后重启 Ollama）---
OLLAMA_NUM_GPU=999
OLLAMA_FLASH_ATTENTION=1

# --- SoVITS（可选，不用语音可留空）---
AMADEUS_SOVITS_URL=http://localhost:9880
# AMADEUS_SOVITS_ROOT=C:\path\to\GPT-SoVITS
# AMADEUS_SOVITS_REF=C:\path\to\GPT-SoVITS\ref.wav
# 本地通话 ASR：默认优先 Windows 中文语音识别；可选 Whisper（需模型）
# AMADEUS_ASR_PYTHON=C:\path\to\python.exe
# AMADEUS_ASR_MODEL=tiny

# --- 常开麦克风 / 声纹旁听（可选，Python voice_daemon）---
# Node 后端地址；应与 AMADEUS_BACKEND_PORT 对齐
AMADEUS_BACKEND=http://127.0.0.1:3002
# faster-whisper 模型：tiny/base/small/medium/large-v3；8GB 显存建议 small 或 base
AMADEUS_ASR_MODEL=small
AMADEUS_ASR_LANGUAGE=zh
# auto/cpu/cuda
AMADEUS_ASR_DEVICE=auto
# CPU 建议 int8；CUDA 可试 float16
AMADEUS_ASR_COMPUTE=int8

# --- Electron（可选）---
# AMADEUS_AUTO_LAUNCH=1
# AMADEUS_DEBUG=1
