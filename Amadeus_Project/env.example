# 复制为 .env 或在本机「用户环境变量」中配置（Ollama 相关变量需作用于运行 ollama serve 的进程）
# 详见 docs/GPU_OLLAMA_SOVITS.md

# --- Amadeus 后端（Node server.js）---
# 服务端口（Electron 与后端需一致）
# AMADEUS_BACKEND_PORT=3000

# 8GB 显存友好：默认已在代码里设为 2048 / 6000，此处仅覆盖
# 1=主对话轻量路径（默认）；0=恢复周期元认知洞察等
# 高亲密度模式（默认开；设为 0 关闭）
AMADEUS_HIGH_INTIMACY=1
# 对话对象：okabe（默认冈部伦太郎）；custom=仅依赖 whoami 档案，不自动认定冈部
AMADEUS_PARTNER_ID=okabe
# 启动时把 whoami 写成冈部档案（0 关闭）
# AMADEUS_PARTNER_BOOTSTRAP=1

AMADEUS_CHAT_MINIMAL=1
AMADEUS_OLLAMA_NUM_CTX=2048
AMADEUS_MAX_PROMPT_CHARS=8000
# 日语校验：0 关闭；默认开启（中文→日译→规则/LLM 自检）
# AMADEUS_JP_VALIDATE=0
# 日语定稿优先：1 时回复后走 JP-first（先日语定稿再译中文，较慢但更稳）
# AMADEUS_JP_FIRST=0
# AMADEUS_JP_LLM_CHECK=0
# AMADEUS_LITE_MODEL=kurisu:latest
# 主对话模型（须与 ollama list 一致）
# AMADEUS_CHAT_MODEL=kurisu:latest
# 多轮对话发往 Ollama 时最多保留几条消息（user+assistant 合计，不含 system）；过大易挤爆 num_ctx
# AMADEUS_CHAT_HISTORY_MSGS=24
AMADEUS_OLLAMA_BASE=http://127.0.0.1:11434
# Ollama 模型常驻时间，8GB 建议 2m，避免长期占满与 SoVITS 抢显存
AMADEUS_OLLAMA_KEEP_ALIVE=2m

# --- Ollama 服务进程（须在启动 ollama 前设置，或写入系统用户环境变量后重启 Ollama）---
OLLAMA_NUM_GPU=999
OLLAMA_FLASH_ATTENTION=1

# --- SoVITS（可选，不用语音可留空）---
AMADEUS_SOVITS_URL=http://localhost:9880
# AMADEUS_SOVITS_ROOT=C:\path\to\GPT-SoVITS
# AMADEUS_SOVITS_REF=C:\path\to\GPT-SoVITS\ref.wav

# --- Electron（可选）---
# AMADEUS_AUTO_LAUNCH=1
# AMADEUS_DEBUG=1
