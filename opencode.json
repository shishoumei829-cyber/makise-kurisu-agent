{
  "$schema": "https://opencode.ai/config.json",
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.git/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/target/**",
      "**/models/**",
      "**/model/**",
      "**/checkpoints/**",
      "**/checkpoint/**",
      "**/weights/**",
      "**/pretrained/**",
      "**/saved_models/**",
      "**/artifacts/**",
      "**/wandb/**",
      "**/mlruns/**",
      "**/lightning_logs/**",
      "**/tensorboard/**",
      "**/runs/**",
      "**/outputs/**",
      "**/logs/**",
      "**/log/**",
      "**/.cache/**",
      "**/.venv/**",
      "**/venv/**",
      "**/__pycache__/**",
      "**/.hf_home/**",
      "**/.huggingface/**",
      "**/datasets/**",
      "**/dataset/**",
      "**/.cursor/**",
      "**/*.safetensors",
      "**/*.bin",
      "**/*.gguf",
      "**/*.pt",
      "**/*.pth",
      "**/*.onnx",
      "**/*.ckpt",
      "**/*.npz",
      "**/*.npy",
      "**/*.arrow",
      "**/*.parquet",
      "**/*.zip",
      "**/*.7z",
      "**/*.tar",
      "**/*.tar.gz",
      "**/*.mp4",
      "**/*.wav"
    ]
  }
}
